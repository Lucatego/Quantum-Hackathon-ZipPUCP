  "qiskit": "# pip install qiskit qiskit-aer\nfrom qiskit import QuantumCircuit, transpile\nfrom qiskit_aer import AerSimulator\n\n# Cañón cuántico de Collapse: 3 qubits = 8 sectores. Piezas: H M D M D.\n# Sector marcado: 3 ('011', little-endian como Qiskit).\nqc = QuantumCircuit(3, 3)\n\n# [1] H: superposición uniforme\nqc.h([0, 1, 2])\n\n# [2] M, marcador (oráculo): invierte la fase del sector 3\nqc.x([2])\nqc.ccz(0, 1, 2)\nqc.x([2])\n\n# [3] D, difusor: 2|s><s| - I (salvo fase global)\nqc.h([0, 1, 2])\nqc.x([0, 1, 2])\nqc.ccz(0, 1, 2)\nqc.x([0, 1, 2])\nqc.h([0, 1, 2])\n\n# [4] M, marcador (oráculo): invierte la fase del sector 3\nqc.x([2])\nqc.ccz(0, 1, 2)\nqc.x([2])\n\n# [5] D, difusor: 2|s><s| - I (salvo fase global)\nqc.h([0, 1, 2])\nqc.x([0, 1, 2])\nqc.ccz(0, 1, 2)\nqc.x([0, 1, 2])\nqc.h([0, 1, 2])\n\nqc.measure([0, 1, 2], [0, 1, 2])   # medición = el disparo\n\nsim = AerSimulator()\ncounts = sim.run(transpile(qc, sim), shots=1024).result().get_counts()\nprint(counts)   # la clave '011' debería salir ~94,5 % de las veces (teoría con k=2)"
